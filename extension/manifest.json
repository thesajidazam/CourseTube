{
  "manifest_version": 3,
  "name": "CourseTube",
  "version": "2.2.2",
  "description": "A calm, full-screen study mode for course playlists: AI notes, chapters, quizzes, Q&A and a friendly study buddy.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ]
}